{
  "name": "@onovoprogramador/onp-spec",
  "version": "0.9.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Spec-anchored development: specs auditable against the code, executable DoD, explicit assumptions and a verifiable constitution. Zero dependencies.",
  "type": "module",
  "bin": {
    "onp-spec": "bin/onp-spec.js"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-include=\"bin/onp-spec.js\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"examples/**\" --test-coverage-exclude=\"skills/**\" --test",
    "bench": "node benchmark/run.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "spec-driven",
    "spec-anchored",
    "sdd",
    "traceability",
    "lgpd",
    "ai-coding",
    "claude-code",
    "codex",
    "cursor",
    "copilot"
  ],
  "author": "Vitor Manoel — O Novo Programador",
  "license": "MIT"
}
